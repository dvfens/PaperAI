# ─────────────────────────────────────────────────────────────────────────────
# Paper AI — environment variables
# Copy to .env.local (or run `npm run setup`, which generates the secrets and an
# Arkiv testnet wallet for you). Every API key stays on the server; only the
# NEXT_PUBLIC_* values are sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

APP_URL=http://localhost:3000

# ── Claude (Anthropic) ── document understanding, conversation, guidance
# Without it the app runs in clearly-labelled "basic mode" (rule-based).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Fast mode for every Claude call: reading the form, answers, next steps (same model, ~2x faster, 2x per-token price). true/false
CLAUDE_FAST_MODE=true

# ── ElevenLabs ── natural multilingual voice (TTS) and Scribe speech-to-text
# Without it the browser's built-in speech synthesis / recognition is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STT_MODEL=scribe_v2

# ── OpenAI (optional) ── a second speech engine people can switch to in the app
# (live recognition gpt-live-transcribe, backup gpt-transcribe, voice gpt-4o-mini-tts).
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_LIVE_STT_MODEL=gpt-live-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ── Arkiv (Rabdi testnet, chain id 7794095) ── document commitments & consent events
# Free access key: https://hub.arkiv.network/access-keys   (not a secret, but restrict it to your origins)
ARKIV_ACCESS_KEY=
NEXT_PUBLIC_ARKIV_ACCESS_KEY=
# TESTNET writer wallet. Fund it at https://hub.arkiv.network/faucet. Never use a mainnet key.
ARKIV_PRIVATE_KEY=

# ── Database ── leave empty to use embedded PGlite (real PostgreSQL in WASM) under ./.data
DATABASE_URL=
# DATABASE_URL=postgres://saathi:saathi@localhost:5432/saathi

# ── Security ── 32 random bytes, base64. Required in production (`npm run setup` generates them).
DOCUMENT_ENCRYPTION_KEY=
APP_SECRET=

# ── Storage ──
# DATA_DIR=.data
# STORAGE_DIR=.data/vault
# OCR_CACHE_DIR=.data/tessdata

# Shows the "change one word and check again" tamper demo on /verify
NEXT_PUBLIC_DEMO_TOOLS=true
